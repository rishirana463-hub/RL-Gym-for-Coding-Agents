* text=auto
.gitattributes text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.toml text eol=lf
*.patch text eol=lf whitespace=-blank-at-eol
*.log text eol=lf
# Preserve historical OpenHands terminal logs' mixed progress-control line endings.
evals/openhands-preflight/logs/*.log -text
evals/template-self-check/*/build-*.log -text whitespace=cr-at-eol
